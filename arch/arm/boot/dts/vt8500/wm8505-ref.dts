/dts-v1/;
/include/ "wm8505.dtsi"

/ {
	model = "Wondermedia WM8505 Netbook";

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 150000>;

		brightness-levels = <0 40 42 46 52 60 70 81
			95 109 126 144 163 184 206 230 255>;

		default-brightness-level = <11>;
	};

	panel {
		compatible = "innolux,at070tn92";
		backlight = <&backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&display_out>;
			};
		};
	};
};

&display {
	status = "okay";
	port {
		display_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};
};

&uart0 {
	status = "okay";
};

&pwm {
	status = "okay";
};

&ac97 {
	status = "okay";
	speaker-gpios = <&pinctrl 3 1>;
};
